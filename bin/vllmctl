#!/usr/bin/env bash
set -euo pipefail
# References:
# https://build.nvidia.com/spark/vllm
# https://build.nvidia.com/spark/vllm/instructions

SCRIPT_RAW_URL="https://raw.githubusercontent.com/cloudxabide/ExMachina/main/bin/vllmctl"
SCRIPT_SHA256_URL="https://raw.githubusercontent.com/cloudxabide/ExMachina/main/bin/vllmctl.sha256"

CONTAINER_NAME="${VLLM_CONTAINER_NAME:-vllm-spark}"
VLLM_IMAGE="${VLLM_IMAGE:-nvcr.io/nvidia/vllm:26.03.post1-py3}"
VLLM_PORT="${VLLM_PORT:-8000}"
HF_CACHE="${HOME}/.cache/huggingface"
LITELLM_CONTAINER_NAME="${CONTAINER_NAME}-litellm"

# GPU profile thresholds (VRAM in MB):
#   small  — ≤6 GB   (e.g. RTX 3050 4 GB  — wheatley)
#   medium — ≤20 GB  (e.g. RTX 4060 Ti 16 GB — jarvis)
#   large  — >20 GB  (e.g. DGX Spark 128 GB UMA — spark-e)

# Available models: short-name -> HuggingFace model ID
declare -A VLLM_MODELS
VLLM_MODELS=(
  # large — DGX Spark (128 GB UMA, NVFP4 tensor cores)
  ["nemotron-super-120b"]="nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4"
  ["nemotron-nano-30b"]="nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-NVFP4"
  ["llama-3.3-70b"]="unsloth/Llama-3.3-70B-Instruct-FP8-Dynamic"
  ["gemma-4-26b"]="google/gemma-4-26B-A4B-it"
  # medium — RTX 4060 Ti 16 GB (jarvis) and up
  ["nemotron-elastic-12b"]="nvidia/Nemotron-Elastic-12B"
  ["nemotron-nano-4b"]="nvidia/Nemotron-3-Nano-4B"
  ["llama-3.1-8b"]="meta-llama/Meta-Llama-3.1-8B-Instruct"
  ["qwen2.5-14b-int4"]="Qwen/Qwen2.5-14B-Instruct-GPTQ-Int4"
  ["deepseek-r1-7b"]="deepseek-ai/DeepSeek-R1-Distill-Qwen-7B"
  # small — RTX 3050 4 GB (wheatley) and up
  ["deepseek-r1-1.5b"]="deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B"
  ["qwen2.5-1.5b"]="Qwen/Qwen2.5-1.5B-Instruct"
  ["llama-3.2-1b"]="meta-llama/Llama-3.2-1B-Instruct"
)

# Stable display order (large -> medium -> small)
MODEL_KEYS=(
  "nemotron-super-120b"
  "nemotron-nano-30b"
  "llama-3.3-70b"
  "gemma-4-26b"
  "nemotron-elastic-12b"
  "nemotron-nano-4b"
  "llama-3.1-8b"
  "qwen2.5-14b-int4"
  "deepseek-r1-7b"
  "deepseek-r1-1.5b"
  "qwen2.5-1.5b"
  "llama-3.2-1b"
)

# Minimum GPU profile required to run each model
declare -A MODEL_MIN_PROFILE
MODEL_MIN_PROFILE=(
  ["nemotron-super-120b"]="large"
  ["nemotron-nano-30b"]="large"
  ["llama-3.3-70b"]="large"
  ["gemma-4-26b"]="large"
  ["nemotron-elastic-12b"]="medium"
  ["nemotron-nano-4b"]="medium"
  ["llama-3.1-8b"]="medium"
  ["qwen2.5-14b-int4"]="medium"
  ["deepseek-r1-7b"]="medium"
  ["deepseek-r1-1.5b"]="small"
  ["qwen2.5-1.5b"]="small"
  ["llama-3.2-1b"]="small"
)

# Per-model environment variable overrides (space-separated -e K=V strings)
declare -A MODEL_EXTRA_ENVS
MODEL_EXTRA_ENVS=(
  ["nemotron-super-120b"]="-e VLLM_NVFP4_GEMM_BACKEND=marlin -e VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 -e VLLM_USE_FLASHINFER_MOE_FP4=0"
  ["nemotron-nano-30b"]="-e VLLM_FLASHINFER_MOE_BACKEND=latency"
  ["llama-3.3-70b"]=""
  ["gemma-4-26b"]=""
  ["nemotron-elastic-12b"]=""
  ["nemotron-nano-4b"]=""
  ["llama-3.1-8b"]=""
  ["qwen2.5-14b-int4"]=""
  ["deepseek-r1-7b"]=""
  ["deepseek-r1-1.5b"]=""
  ["qwen2.5-1.5b"]=""
  ["llama-3.2-1b"]=""
)

# Per-model vllm serve flags — tuned for the model's minimum profile
declare -A MODEL_SERVE_ARGS
MODEL_SERVE_ARGS=(
  # large
  ["nemotron-super-120b"]="--max-model-len 32768 --gpu-memory-utilization 0.90 --trust-remote-code"
  ["nemotron-nano-30b"]="--quantization modelopt_fp4 --kv-cache-dtype fp8 --trust-remote-code --max-model-len 131072 --gpu-memory-utilization 0.85"
  ["llama-3.3-70b"]="--max-model-len 32768 --gpu-memory-utilization 0.90 --enable-auto-tool-choice --tool-call-parser llama3_json"
  ["gemma-4-26b"]="--max-model-len 32768 --gpu-memory-utilization 0.90 --limit-mm-per-prompt {\"image\":150,\"video\":1,\"audio\":0} --enable-prefix-caching"
  # medium — conservative context so KV cache fits in 16 GB
  ["nemotron-elastic-12b"]="--quantization fp8 --max-model-len 4096 --gpu-memory-utilization 0.92 --enable-auto-tool-choice --tool-call-parser hermes --trust-remote-code --enforce-eager"
  ["nemotron-nano-4b"]="--max-model-len 16384 --gpu-memory-utilization 0.90 --enable-auto-tool-choice --tool-call-parser hermes"
  ["llama-3.1-8b"]="--max-model-len 32768 --gpu-memory-utilization 0.90 --enable-auto-tool-choice --tool-call-parser llama3_json"
  ["qwen2.5-14b-int4"]="--quantization gptq --max-model-len 8192 --gpu-memory-utilization 0.90 --enable-auto-tool-choice --tool-call-parser hermes"
  ["deepseek-r1-7b"]="--max-model-len 16384 --gpu-memory-utilization 0.90"
  # small — tight limits for 4 GB; single sequence to avoid OOM
  ["deepseek-r1-1.5b"]="--max-model-len 4096 --gpu-memory-utilization 0.85 --max-num-seqs 1"
  ["qwen2.5-1.5b"]="--max-model-len 4096 --gpu-memory-utilization 0.85 --max-num-seqs 1 --enable-auto-tool-choice --tool-call-parser hermes"
  ["llama-3.2-1b"]="--max-model-len 4096 --gpu-memory-utilization 0.85 --max-num-seqs 1 --enable-auto-tool-choice --tool-call-parser llama3_json"
)

DRY_RUN=false

# Print the command (to stderr) instead of running it when DRY_RUN=true.
run_cmd() {
  if [[ "$DRY_RUN" == true ]]; then
    printf '[dry-run]' >&2
    printf ' %q' "$@" >&2
    printf '\n' >&2
    return 0
  fi
  "$@"
}

# Detect GPU profile from nvidia-smi VRAM; falls back to "large" if detection fails.
detect_gpu_profile() {
  local vram_mb
  vram_mb=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null \
    | head -1 | tr -d ' ')
  if [[ -z "$vram_mb" || ! "$vram_mb" =~ ^[0-9]+$ ]]; then
    echo "large"
    return
  fi
  if   (( vram_mb <=  6000 )); then echo "small"
  elif (( vram_mb <= 20000 )); then echo "medium"
  else                               echo "large"
  fi
}

profile_level() {
  case "$1" in
    small)  echo 1 ;;
    medium) echo 2 ;;
    large)  echo 3 ;;
    *)      echo 0 ;;
  esac
}

usage() {
  cat <<EOF
Usage: $(basename "$0") [--dry-run|-n] <command>

Commands:
  start          Select a model and start the vLLM server (+ optional litellm proxy)
  stop           Stop the vLLM server (and litellm proxy if running)
  status         Show running state and API health
  list           List models loaded in the running server
  logs           Tail vLLM container logs
  update         Pull the latest vLLM image and restart
  self-update    Pull the latest version of this script from git
  proxy start    Start the litellm proxy against the running vLLM server
  proxy stop     Stop the litellm proxy

Options:
  --dry-run, -n  Print commands that would run without executing them
EOF
  exit 1
}

require_docker() {
  if ! docker info >/dev/null 2>&1; then
    echo "Error: Docker daemon not reachable." >&2
    exit 1
  fi
}

require_hf_token() {
  if [[ -z "${HF_TOKEN:-}" ]]; then
    echo "Error: HF_TOKEN is not set. Export it before running this script." >&2
    exit 1
  fi
}

select_model() {
  local profile host_level
  profile=$(detect_gpu_profile)
  host_level=$(profile_level "$profile")
  echo "GPU profile: $profile"

  local available_keys=()
  for key in "${MODEL_KEYS[@]}"; do
    local min_level
    min_level=$(profile_level "${MODEL_MIN_PROFILE[$key]:-small}")
    (( host_level >= min_level )) && available_keys+=("$key")
  done

  if [[ ${#available_keys[@]} -eq 0 ]]; then
    echo "ERROR: no models available for profile '$profile'" >&2
    exit 1
  fi

  echo "Available vLLM models:"
  PS3="Select a model (enter number): "
  select CHOICE in "${available_keys[@]}" "Quit"; do
    if [[ "$CHOICE" == "Quit" ]]; then
      echo "Exiting."
      exit 0
    elif [[ -n "${VLLM_MODELS[$CHOICE]+_}" ]]; then
      HF_MODEL_ID="${VLLM_MODELS[$CHOICE]}"
      EXTRA_ENVS="${MODEL_EXTRA_ENVS[$CHOICE]}"
      SERVE_ARGS="${MODEL_SERVE_ARGS[$CHOICE]}"
      echo "Selected: $CHOICE -> $HF_MODEL_ID"
      break
    else
      echo "Invalid selection, try again."
    fi
  done
}

do_proxy_start() {
  local model_id
  if [[ "$DRY_RUN" == true ]]; then
    model_id="<model-id-from-running-vllm>"
    echo "Note: model ID would be detected from the running vLLM API at port ${VLLM_PORT}" >&2
  else
    if ! curl -sf "http://localhost:${VLLM_PORT}/health" >/dev/null 2>&1; then
      echo "Error: vLLM is not running on port ${VLLM_PORT}. Start it first with: $(basename "$0") start" >&2
      exit 1
    fi
    model_id=$(curl -s "http://localhost:${VLLM_PORT}/v1/models" \
      | python3 -c "import sys,json; d=json.load(sys.stdin)['data']; print(d[0]['id']) if d else sys.exit(1)" 2>/dev/null)
    if [[ -z "$model_id" ]]; then
      echo "Error: could not determine loaded model from vLLM API." >&2
      exit 1
    fi
    echo "Detected model: $model_id"
  fi
  start_litellm_proxy "$model_id"
}

do_proxy_stop() {
  if [ -n "$(docker ps -q --filter "name=^${LITELLM_CONTAINER_NAME}$" --filter "status=running")" ]; then
    echo "Stopping ${LITELLM_CONTAINER_NAME}..."
    run_cmd docker stop "${LITELLM_CONTAINER_NAME}"
    [[ "$DRY_RUN" == false ]] && echo "Stopped."
  else
    echo "litellm proxy is not running."
  fi
}

start_litellm_proxy() {
  local model_id="$1"
  local primary_ip
  primary_ip=$(ip route get 1.1.1.1 2>/dev/null | awk '/src/ {print $7; exit}' || echo "0.0.0.0")

  local config_path
  if [[ "$DRY_RUN" == true ]]; then
    config_path="/tmp/litellm-config-XXXXXX/config.yaml"
    printf '[dry-run] would write litellm config:\n  model_list:\n  - model_name: "*"\n    litellm_params:\n      model: "openai/%s"\n      api_base: "http://localhost:%s/v1"\n      api_key: "dummy"\n' \
      "$model_id" "$VLLM_PORT" >&2
  else
    local config_dir
    config_dir=$(mktemp -d)
    config_path="$config_dir/config.yaml"
    cat > "$config_path" <<EOF
model_list:
  - model_name: "*"
    litellm_params:
      model: "openai/${model_id}"
      api_base: "http://localhost:${VLLM_PORT}/v1"
      api_key: "dummy"
EOF
  fi

  if docker inspect "$LITELLM_CONTAINER_NAME" >/dev/null 2>&1; then
    local old="${LITELLM_CONTAINER_NAME}-$(date +%Y%m%d-%H%M%S)"
    echo "Existing litellm container found — renaming to '$old' and stopping..."
    run_cmd docker rename "$LITELLM_CONTAINER_NAME" "$old"
    run_cmd docker stop "$old" || true
  fi

  echo "Starting litellm proxy on ${primary_ip}:4000 -> http://localhost:${VLLM_PORT}/v1 ..."
  local litellm_cmd=(
    docker run -d --rm
    --name="$LITELLM_CONTAINER_NAME"
    --network=host
    -e OPENAI_API_KEY=dummy
    -v "$config_path:/app/config.yaml:ro"
    ghcr.io/berriai/litellm:main-stable
    --config /app/config.yaml
    --port 4000
    --host "$primary_ip"
  )
  run_cmd "${litellm_cmd[@]}"

  [[ "$DRY_RUN" == true ]] && return

  echo "Waiting for litellm to become ready..."
  local ready=false
  for i in $(seq 1 30); do
    if curl -sf "http://${primary_ip}:4000/health" >/dev/null 2>&1; then
      ready=true; break
    fi
    sleep 2
  done

  if [[ "$ready" == false ]]; then
    echo "ERROR: litellm did not start within 60 seconds. Check: docker logs $LITELLM_CONTAINER_NAME" >&2
    docker stop "$LITELLM_CONTAINER_NAME" 2>/dev/null || true
    exit 1
  fi

  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  litellm proxy ready. Configure your tools:"
  echo ""
  echo "  OpenCode / OpenAI-compatible:"
  echo "    export OPENAI_BASE_URL=http://${primary_ip}:4000/v1"
  echo "    export OPENAI_API_KEY=dummy"
  echo ""
  echo "  Claude Code:"
  echo "    export ANTHROPIC_BASE_URL=http://${primary_ip}:4000"
  echo "    export ANTHROPIC_API_KEY=dummy"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
}

watch_startup() {
  local start
  start=$(date +%s)

  echo ""
  echo "━━━ Startup progress (full logs: $(basename "$0") logs) ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

  # Tail filtered log lines in the background.
  # Strip ANSI codes so tqdm progress bars print cleanly.
  docker logs -f "$CONTAINER_NAME" 2>&1 \
    | sed 's/\x1b\[[0-9;]*[mGKH]//g' \
    | grep --line-buffered -E \
        'Downloading|Loading weights|safetensors checkpoint|CUDA graph|warmup|Uvicorn running|Application startup complete|ERROR|Exception|Traceback' \
    | while IFS= read -r line; do
        elapsed=$(( $(date +%s) - start ))
        printf "  [%4ds] %s\n" "$elapsed" "$line"
      done &
  local log_pid=$!

  local ready=false
  local i=0
  while (( i < 120 )); do
    if curl -sf "http://localhost:${VLLM_PORT}/health" >/dev/null 2>&1; then
      ready=true
      break
    fi
    sleep 5
    i=$(( i + 1 ))
    # Heartbeat every 60s so it doesn't look hung between log milestones
    if (( i % 12 == 0 )); then
      elapsed=$(( $(date +%s) - start ))
      printf "  [%4ds] (still loading — run '%s logs' in another terminal for full output)\n" \
        "$elapsed" "$(basename "$0")"
    fi
  done

  kill "$log_pid" 2>/dev/null || true
  wait "$log_pid" 2>/dev/null || true

  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  if [[ "$ready" == true ]]; then
    elapsed=$(( $(date +%s) - start ))
    echo "vLLM is ready. (startup took ${elapsed}s)"
  else
    elapsed=$(( $(date +%s) - start ))
    echo "WARNING: API did not respond after ${elapsed}s. Model may still be loading."
    echo "  Monitor with: $(basename "$0") logs"
  fi
}

do_start() {
  require_hf_token
  select_model

  if docker inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
    local old="${CONTAINER_NAME}-$(date +%Y%m%d-%H%M%S)"
    echo "Existing container '$CONTAINER_NAME' found — renaming to '$old' and stopping..."
    run_cmd docker rename "$CONTAINER_NAME" "$old"
    run_cmd docker stop "$old" || true
  fi

  run_cmd mkdir -p "$HF_CACHE"

  read -rp "Start litellm proxy for Claude Code / OpenCode access (port 4000)? [y/N]: " PROXY_CHOICE
  START_PROXY=false
  [[ "$PROXY_CHOICE" =~ ^[Yy]$ ]] && START_PROXY=true

  echo "Starting vLLM: $HF_MODEL_ID on port $VLLM_PORT ..."
  local vllm_cmd=(
    docker run -d
    --name="$CONTAINER_NAME"
    --gpus all
    --ipc=host
    --network=host
    -e "HF_TOKEN=$HF_TOKEN"
  )
  if [[ -n "$EXTRA_ENVS" ]]; then
    read -ra _extra_envs <<< "$EXTRA_ENVS"
    vllm_cmd+=("${_extra_envs[@]}")
  fi
  vllm_cmd+=(
    -v "$HF_CACHE:/root/.cache/huggingface"
    "$VLLM_IMAGE"
    vllm serve "$HF_MODEL_ID"
    --host 0.0.0.0
    --port "$VLLM_PORT"
  )
  if [[ -n "$SERVE_ARGS" ]]; then
    read -ra _serve_args <<< "$SERVE_ARGS"
    vllm_cmd+=("${_serve_args[@]}")
  fi
  run_cmd "${vllm_cmd[@]}"

  [[ "$DRY_RUN" == false ]] && watch_startup

  [[ "$START_PROXY" == true ]] && start_litellm_proxy "$HF_MODEL_ID"
}

do_stop() {
  local stopped_any=false

  for name in "$CONTAINER_NAME" "$LITELLM_CONTAINER_NAME"; do
    if [ -n "$(docker ps -q --filter "name=^${name}$" --filter "status=running")" ]; then
      echo "Stopping ${name}..."
      run_cmd docker stop "${name}"
      stopped_any=true
    fi
  done

  [[ "$stopped_any" == false ]] && echo "No running vLLM containers found."
}

do_status() {
  echo "Container status:"
  for name in "$CONTAINER_NAME" "$LITELLM_CONTAINER_NAME"; do
    if [ -n "$(docker ps -q --filter "name=^${name}$" --filter "status=running")" ]; then
      printf "  %-30s running\n" "$name"
    elif [ -n "$(docker ps -aq --filter "name=^${name}$")" ]; then
      printf "  %-30s stopped\n" "$name"
    else
      printf "  %-30s not found\n" "$name"
    fi
  done

  echo ""
  echo "API health (port $VLLM_PORT):"
  if curl -sf "http://localhost:${VLLM_PORT}/health" >/dev/null 2>&1; then
    echo "  http://localhost:${VLLM_PORT}  healthy"
  else
    echo "  http://localhost:${VLLM_PORT}  unreachable"
  fi
}

do_list() {
  if ! curl -sf "http://localhost:${VLLM_PORT}/health" >/dev/null 2>&1; then
    echo "Error: vLLM API not reachable on port $VLLM_PORT." >&2
    exit 1
  fi
  echo "Models served at http://localhost:${VLLM_PORT}/v1/models:"
  curl -s "http://localhost:${VLLM_PORT}/v1/models" | python3 -c "
import sys, json
data = json.load(sys.stdin)
for m in data.get('data', []):
    print('  ' + m['id'])
"
}

do_logs() {
  if ! docker inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
    echo "Error: Container '$CONTAINER_NAME' not found." >&2
    exit 1
  fi
  docker logs -f "$CONTAINER_NAME"
}

do_self_update() {
  local script_path
  script_path=$(readlink -f "$0")
  local repo_root
  repo_root=$(git -C "$(dirname "$script_path")" rev-parse --show-toplevel 2>/dev/null || true)

  if [[ -n "$repo_root" ]]; then
    # Inside a clone — pull the repo
    echo "Repo: $repo_root"
    if [[ "$DRY_RUN" == true ]]; then
      run_cmd git -C "$repo_root" pull --ff-only
      return
    fi
    local before after
    before=$(git -C "$repo_root" rev-parse HEAD)
    git -C "$repo_root" pull --ff-only
    after=$(git -C "$repo_root" rev-parse HEAD)
    if [[ "$before" == "$after" ]]; then
      echo "Already up to date."
      return
    fi
    echo ""
    echo "Updated ${before:0:7}..${after:0:7}"
    git -C "$repo_root" log --oneline "${before}..${after}"
    if git -C "$repo_root" diff --name-only "${before}..${after}" | grep -q "$(basename "$script_path")"; then
      echo ""
      echo "$(basename "$0") was updated — changes are live."
    fi
  else
    # Standalone deployment — fetch directly from GitHub
    if [[ "$DRY_RUN" == true ]]; then
      printf '[dry-run] curl -fsSL %q -o <tmp>\n' "$SCRIPT_RAW_URL" >&2
      printf '[dry-run] curl -fsSL %q -o <tmp.sha256>\n' "$SCRIPT_SHA256_URL" >&2
      printf '[dry-run] sha256sum verify\n' >&2
      printf '[dry-run] cp <tmp> %q\n' "$script_path" >&2
      return
    fi
    echo "Fetching latest $(basename "$0") from GitHub..."
    local tmp tmp_sum
    tmp=$(mktemp)
    tmp_sum=$(mktemp)
    if ! curl -fsSL "$SCRIPT_RAW_URL" -o "$tmp"; then
      echo "Error: download failed from $SCRIPT_RAW_URL" >&2
      rm -f "$tmp" "$tmp_sum"; exit 1
    fi
    if ! curl -fsSL "$SCRIPT_SHA256_URL" -o "$tmp_sum"; then
      echo "Error: checksum download failed from $SCRIPT_SHA256_URL" >&2
      rm -f "$tmp" "$tmp_sum"; exit 1
    fi
    local expected actual
    expected=$(tr -d '[:space:]' < "$tmp_sum")
    actual=$(sha256sum "$tmp" | awk '{print $1}')
    if [[ "$expected" != "$actual" ]]; then
      echo "Error: checksum mismatch (expected $expected, got $actual)" >&2
      rm -f "$tmp" "$tmp_sum"; exit 1
    fi
    chmod +x "$tmp"
    cp "$tmp" "$script_path"
    rm -f "$tmp" "$tmp_sum"
    echo "$(basename "$0") updated (checksum verified)."
  fi
}

do_update() {
  echo "Pulling latest image: $VLLM_IMAGE ..."
  run_cmd docker pull "$VLLM_IMAGE"

  if [ -n "$(docker ps -q --filter "name=^${CONTAINER_NAME}$" --filter "status=running")" ]; then
    echo "Stopping $CONTAINER_NAME for update..."
    run_cmd docker stop "$CONTAINER_NAME"
    run_cmd docker rm "$CONTAINER_NAME"
    echo "Image updated. Run '$(basename "$0") start' to restart with the new image."
  else
    echo "Image updated. No running container to restart."
  fi
}

# ── main ─────────────────────────────────────────────────────────────────────

# Strip --dry-run / -n from args before dispatch
_args=()
for _arg in "$@"; do
  case "$_arg" in
    --dry-run|-n) DRY_RUN=true ;;
    *) _args+=("$_arg") ;;
  esac
done
set -- "${_args[@]+"${_args[@]}"}"
unset _arg _args

cmd="${1:-}"
[[ -z "$cmd" ]] && usage

case "$cmd" in
  start)        require_docker; do_start ;;
  stop)         require_docker; do_stop ;;
  status)       require_docker; do_status ;;
  list)         require_docker; do_list ;;
  logs)         require_docker; do_logs ;;
  update)       require_docker; do_update ;;
  self-update)  do_self_update ;;
  proxy)
    subcmd="${2:-}"
    case "$subcmd" in
      start) require_docker; do_proxy_start ;;
      stop)  require_docker; do_proxy_stop ;;
      *) echo "Error: usage: $(basename "$0") proxy <start|stop>" >&2; exit 1 ;;
    esac
    ;;
  *)
    echo "Error: Unknown command '$cmd'" >&2
    usage
    ;;
esac
