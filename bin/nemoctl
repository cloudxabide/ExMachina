#!/bin/bash

#    Status: vLLM  | Working | Still a Work in Progress
#            TensorRT | Untested | Need to test
#
#      Goal: Easy button for deploying Nemotron models on homelab hardware
# Reference: https://github.com/NVIDIA-NeMo/Nemotron/tree/main/usage-cookbook/Nemotron-3-Super/SparkDeploymentGuide

set -euo pipefail

SCRIPT_NAME=$(basename "$0")
COMMAND=""
ENGINE=""
CHECKPOINT=""
SELECTED_HOST=""
FOREGROUND=false
FOLLOW=false

REASONING_PARSER_URL="https://huggingface.co/nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4/raw/main/super_v3_reasoning_parser.py"
REASONING_PARSER_FILE="super_v3_reasoning_parser.py"

# Host -> Nemotron model mapping
declare -A HOST_MODEL
HOST_MODEL=(
  ["spark-e"]="nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4"
  ["jarvis"]="nvidia/Nemotron-Elastic-12B"
  ["wheatley"]="nvidia/NVIDIA-Nemotron-3-Nano-4B-FP8"
)

declare -A HOST_SERVED_NAME
HOST_SERVED_NAME=(
  ["spark-e"]="nemotron-super"
  ["jarvis"]="nemotron-elastic"
  ["wheatley"]="nemotron-nano"
)

# spark-e needs CUDA 13.0 nightly; jarvis/wheatley use stable
declare -A HOST_IMAGE
HOST_IMAGE=(
  ["spark-e"]="vllm/vllm-openai:cu130-nightly"
  ["jarvis"]="nvcr.io/nvidia/vllm:26.03.post1-py3"
  ["wheatley"]="nvcr.io/nvidia/vllm:26.03.post1-py3"
)

MODEL=""
SERVED_MODEL_NAME=""
VLLM_IMAGE_TO_USE=""
CONTAINER_NAME=""

TENSORRT_IMAGE="nvcr.io/nvidia/tensorrt-llm/release:1.3.0rc9"
VLLM_PORT=8000
TENSORRT_PORT=8123

usage() {
  cat <<EOF
Usage: $SCRIPT_NAME <command> [options]

Commands:
  start     Start the inference server (detached by default)
  stop      Stop the running inference server
  status    Show container state and API health
  logs      Show container logs
  update    Pull the latest image (and restart if running)

Options:
  -e, --engine <vllm|tensorrt>    Inference engine (required for start/update)
  -c, --checkpoint <path>         Model checkpoint path (required for tensorrt start)
  -f, --follow                    Follow log output (logs command)
      --foreground                Run interactively in the foreground (start command)
  -h, --help                      Show this help message

Examples:
  $SCRIPT_NAME start --engine vllm
  $SCRIPT_NAME start --engine vllm --foreground
  $SCRIPT_NAME start --engine tensorrt --checkpoint /path/to/nvfp4_ckpt
  $SCRIPT_NAME stop
  $SCRIPT_NAME status
  $SCRIPT_NAME logs --follow
  $SCRIPT_NAME update --engine vllm
EOF
}

# Sets SELECTED_HOST, MODEL, SERVED_MODEL_NAME, VLLM_IMAGE_TO_USE, CONTAINER_NAME.
# Idempotent: if SELECTED_HOST is already set, skips detection.
# mode: "confirm" prompts for model confirmation (start); "quiet" skips it (stop/status/logs).
select_host() {
  local mode="${1:-confirm}"

  if [[ -n "$SELECTED_HOST" ]]; then
    MODEL="${HOST_MODEL[$SELECTED_HOST]}"
    SERVED_MODEL_NAME="${HOST_SERVED_NAME[$SELECTED_HOST]}"
    VLLM_IMAGE_TO_USE="${HOST_IMAGE[$SELECTED_HOST]}"
    CONTAINER_NAME="nemoctl-${SELECTED_HOST}"
    return
  fi

  local detected_host
  detected_host=$(hostname -s)

  if [[ -n "${HOST_MODEL[$detected_host]+_}" ]]; then
    SELECTED_HOST="$detected_host"
    if [[ "$mode" == "confirm" ]]; then
      echo "Detected host : $detected_host"
      echo "Proposed model: ${HOST_MODEL[$detected_host]}"
      echo ""
      read -rp "Proceed with this model? [Y/n]: " confirm
      if [[ "$confirm" =~ ^[Nn]$ ]]; then
        echo "Aborted."
        exit 0
      fi
    fi
  else
    echo "WARNING: hostname '$detected_host' is not in the host-model map." >&2
    echo ""
    echo "Known host profiles:"
    local host_keys=("${!HOST_MODEL[@]}")
    PS3="Select a profile (enter number): "
    select CHOICE in "${host_keys[@]}" "Quit"; do
      if [[ "$CHOICE" == "Quit" ]]; then
        echo "Exiting."
        exit 0
      elif [[ -n "${HOST_MODEL[$CHOICE]+_}" ]]; then
        SELECTED_HOST="$CHOICE"
        echo "Selected: $CHOICE -> ${HOST_MODEL[$CHOICE]}"
        break
      else
        echo "Invalid selection, try again."
      fi
    done
  fi

  MODEL="${HOST_MODEL[$SELECTED_HOST]}"
  SERVED_MODEL_NAME="${HOST_SERVED_NAME[$SELECTED_HOST]}"
  VLLM_IMAGE_TO_USE="${HOST_IMAGE[$SELECTED_HOST]}"
  CONTAINER_NAME="nemoctl-${SELECTED_HOST}"
}

do_start_vllm() {
  if [[ -z "${HF_TOKEN:-}" ]]; then
    echo "ERROR: HF_TOKEN is not set — required for vLLM model pull" >&2
    exit 1
  fi

  select_host "confirm"

  mkdir -p "${HOME}/.cache/huggingface"
  chmod 777 "${HOME}/.cache/huggingface"

  if [[ "$(docker inspect --format '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null)" == "true" ]]; then
    echo "ERROR: $CONTAINER_NAME is already running. Use '$SCRIPT_NAME stop' first." >&2
    exit 1
  fi
  docker rm -f "$CONTAINER_NAME" 2>/dev/null || true

  local run_mode
  if [[ "$FOREGROUND" == true ]]; then
    run_mode=(--rm -it)
  else
    run_mode=(--detach --name "$CONTAINER_NAME" --restart unless-stopped)
  fi

  local cmd=(
    docker run
    "${run_mode[@]}"
    --gpus all
    -e "HF_TOKEN=$HF_TOKEN"
    -e "HF_HOME=/hf_cache"
    -v "${HOME}/.cache/huggingface:/hf_cache:z"
    -p "${VLLM_PORT}:${VLLM_PORT}"
    --label "nemoctl.engine=vllm"
    --label "nemoctl.port=${VLLM_PORT}"
  )

  case "$SELECTED_HOST" in
    spark-e)
      cmd+=(
        -e VLLM_NVFP4_GEMM_BACKEND=marlin
        -e VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
        -e VLLM_FLASHINFER_ALLREDUCE_BACKEND=trtllm
        -e VLLM_USE_FLASHINFER_MOE_FP4=0
      )
      if [[ ! -f "$REASONING_PARSER_FILE" ]]; then
        echo "Downloading reasoning parser..."
        wget -q "$REASONING_PARSER_URL"
      fi
      cmd+=(-v "$(pwd)/$REASONING_PARSER_FILE:/app/$REASONING_PARSER_FILE")
      ;;
  esac

  cmd+=("$VLLM_IMAGE_TO_USE")
  cmd+=(
    vllm serve "$MODEL"
    --served-model-name "$SERVED_MODEL_NAME"
    --host 0.0.0.0
    --port "$VLLM_PORT"
  )

  case "$SELECTED_HOST" in
    spark-e)
      cmd+=(
        --async-scheduling
        --dtype auto
        --kv-cache-dtype fp8
        --tensor-parallel-size 1
        --pipeline-parallel-size 1
        --data-parallel-size 1
        --trust-remote-code
        --gpu-memory-utilization 0.90
        --enable-chunked-prefill
        --max-num-seqs 4
        --max-model-len 1000000
        --moe-backend marlin
        --mamba_ssm_cache_dtype float32
        --quantization fp4
        --speculative_config '{"method":"mtp","num_speculative_tokens":3,"moe_backend":"triton"}'
        --reasoning-parser-plugin "/app/${REASONING_PARSER_FILE}"
        --reasoning-parser super_v3
        --enable-auto-tool-choice
        --tool-call-parser qwen3_coder
      )
      ;;
    jarvis)
      cmd+=(
        --quantization fp8
        --max-model-len 32768
        --gpu-memory-utilization 0.92
        --enable-auto-tool-choice
        --tool-call-parser hermes
        --trust-remote-code
        --enforce-eager
      )
      ;;
    wheatley)
      cmd+=(
        --max-model-len 16384
        --gpu-memory-utilization 0.90
        --enable-auto-tool-choice
        --tool-call-parser hermes
      )
      ;;
  esac

  "${cmd[@]}"

  if [[ "$FOREGROUND" == false ]]; then
    echo "Started: $CONTAINER_NAME"
    echo "  Logs  : $SCRIPT_NAME logs --follow"
    echo "  Status: $SCRIPT_NAME status"
  fi
}

do_start_tensorrt() {
  if [[ -z "$CHECKPOINT" ]]; then
    echo "ERROR: --checkpoint is required for tensorrt engine" >&2
    usage >&2
    exit 1
  fi

  if [[ ! -d "$CHECKPOINT" ]]; then
    echo "ERROR: checkpoint path not found: $CHECKPOINT" >&2
    exit 1
  fi

  select_host "confirm"

  if [[ "$(docker inspect --format '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null)" == "true" ]]; then
    echo "ERROR: $CONTAINER_NAME is already running. Use '$SCRIPT_NAME stop' first." >&2
    exit 1
  fi
  docker rm -f "$CONTAINER_NAME" 2>/dev/null || true

  local HOST_MODEL_DIR CKPT_NAME
  HOST_MODEL_DIR="$(dirname "$CHECKPOINT")"
  CKPT_NAME="$(basename "$CHECKPOINT")"
  local CONTAINER_MODEL_DIR="/models"

  local run_mode
  if [[ "$FOREGROUND" == true ]]; then
    run_mode=(--rm -it)
  else
    run_mode=(--detach --name "$CONTAINER_NAME" --restart unless-stopped)
  fi

  docker pull "$TENSORRT_IMAGE"

  docker run \
    "${run_mode[@]}" \
    --gpus all \
    --ipc=host \
    --ulimit memlock=-1 \
    --ulimit stack=67108864 \
    -v "${HOST_MODEL_DIR}:${CONTAINER_MODEL_DIR}" \
    -p "${TENSORRT_PORT}:${TENSORRT_PORT}" \
    --label "nemoctl.engine=tensorrt" \
    --label "nemoctl.port=${TENSORRT_PORT}" \
    --label "nemoctl.checkpoint=${CHECKPOINT}" \
    "$TENSORRT_IMAGE" bash -c "

cat << 'YAMLEOF' | tee extra-llm-api-config.yml
kv_cache_config:
  dtype: fp8
  enable_block_reuse: false
  free_gpu_memory_fraction: 0.9
  mamba_ssm_cache_dtype: float16
  mamba_ssm_stochastic_rounding: true
  mamba_ssm_philox_rounds: 5
moe_config:
   backend: CUTLASS
cuda_graph_config:
    enable_padding: true
    max_batch_size: 8
enable_attention_dp: false
enable_chunked_prefill: true
stream_interval: 1
print_iter_log: true
speculative_config:
  decoding_type: MTP
  num_nextn_predict_layers: 3
  allow_advanced_sampling: true
YAMLEOF

TLLM_ALLOW_LONG_MAX_MODEL_LEN=1 \\
trtllm-serve ${CONTAINER_MODEL_DIR}/${CKPT_NAME} \\
  --host 0.0.0.0 \\
  --port ${TENSORRT_PORT} \\
  --max_batch_size 8 \\
  --tp_size 1 \\
  --ep_size 1 \\
  --max_num_tokens 8192 \\
  --trust_remote_code \\
  --reasoning_parser nano-v3 \\
  --tool_parser qwen3_coder \\
  --extra_llm_api_options extra-llm-api-config.yml \\
  --max_seq_len 1048576
"

  if [[ "$FOREGROUND" == false ]]; then
    echo "Started: $CONTAINER_NAME"
    echo "  Logs  : $SCRIPT_NAME logs --follow"
    echo "  Status: $SCRIPT_NAME status"
  fi
}

do_stop() {
  select_host "quiet"

  if [[ "$(docker inspect --format '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null)" == "true" ]]; then
    echo "Stopping $CONTAINER_NAME..."
    docker stop "$CONTAINER_NAME" && docker rm "$CONTAINER_NAME"
    echo "Stopped."
  elif docker inspect "$CONTAINER_NAME" &>/dev/null; then
    docker rm "$CONTAINER_NAME"
    echo "$CONTAINER_NAME was already stopped; removed."
  else
    echo "No container found: $CONTAINER_NAME"
  fi
}

do_status() {
  select_host "quiet"

  echo "=== Container ==="
  if ! docker inspect "$CONTAINER_NAME" &>/dev/null; then
    echo "Not found: $CONTAINER_NAME"
    return
  fi

  docker ps -a \
    --filter "name=^${CONTAINER_NAME}$" \
    --format "table {{.Names}}\t{{.Status}}\t{{.Image}}"

  local port
  port=$(docker inspect "$CONTAINER_NAME" \
    --format '{{index .Config.Labels "nemoctl.port"}}' 2>/dev/null || true)

  if [[ -n "$port" ]]; then
    echo ""
    echo "=== API Health (http://localhost:${port}/health) ==="
    if curl -sf --max-time 5 "http://localhost:${port}/health" > /dev/null 2>&1; then
      echo "OK"
    else
      echo "Not responding (model may still be loading)"
    fi
  fi
}

do_logs() {
  select_host "quiet"

  if ! docker inspect "$CONTAINER_NAME" &>/dev/null; then
    echo "No container found: $CONTAINER_NAME" >&2
    exit 1
  fi

  if [[ "$FOLLOW" == true ]]; then
    docker logs -f "$CONTAINER_NAME"
  else
    docker logs --tail 100 "$CONTAINER_NAME"
  fi
}

do_update() {
  select_host "quiet"

  local image
  case "$ENGINE" in
    vllm)     image="$VLLM_IMAGE_TO_USE" ;;
    tensorrt) image="$TENSORRT_IMAGE" ;;
  esac

  local was_running=false
  if [[ "$(docker inspect --format '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null)" == "true" ]]; then
    was_running=true
    if [[ "$ENGINE" == "tensorrt" && -z "$CHECKPOINT" ]]; then
      CHECKPOINT=$(docker inspect "$CONTAINER_NAME" \
        --format '{{index .Config.Labels "nemoctl.checkpoint"}}' 2>/dev/null || true)
    fi
  fi

  echo "Pulling ${image}..."
  docker pull "$image"
  echo "Pull complete."

  if [[ "$was_running" == true ]]; then
    echo "Restarting $CONTAINER_NAME..."
    docker stop "$CONTAINER_NAME" && docker rm "$CONTAINER_NAME"
    FOREGROUND=false
    case "$ENGINE" in
      vllm)     do_start_vllm ;;
      tensorrt) do_start_tensorrt ;;
    esac
  else
    echo "Image updated. Run '$SCRIPT_NAME start --engine $ENGINE' to start."
  fi
}

# --- Argument parsing ---

if [[ $# -eq 0 ]]; then
  usage
  exit 1
fi

COMMAND="$1"
shift

while [[ $# -gt 0 ]]; do
  case "$1" in
    -e|--engine)
      ENGINE="${2:-}"
      shift 2
      ;;
    -c|--checkpoint)
      CHECKPOINT="${2:-}"
      shift 2
      ;;
    -f|--follow)
      FOLLOW=true
      shift
      ;;
    --foreground)
      FOREGROUND=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

case "$COMMAND" in
  start)
    if [[ -z "$ENGINE" ]]; then
      echo "ERROR: --engine is required for start" >&2
      usage >&2
      exit 1
    fi
    case "$ENGINE" in
      vllm)     do_start_vllm ;;
      tensorrt) do_start_tensorrt ;;
      *)
        echo "ERROR: unknown engine '$ENGINE' — expected: vllm, tensorrt" >&2
        exit 1
        ;;
    esac
    ;;
  stop)   do_stop ;;
  status) do_status ;;
  logs)   do_logs ;;
  update)
    if [[ -z "$ENGINE" ]]; then
      echo "ERROR: --engine is required for update" >&2
      usage >&2
      exit 1
    fi
    case "$ENGINE" in
      vllm|tensorrt) do_update ;;
      *)
        echo "ERROR: unknown engine '$ENGINE' — expected: vllm, tensorrt" >&2
        exit 1
        ;;
    esac
    ;;
  help|-h|--help)
    usage
    exit 0
    ;;
  *)
    echo "ERROR: unknown command '$COMMAND'" >&2
    usage >&2
    exit 1
    ;;
esac
