#!/usr/bin/env bash
set -euo pipefail

SCRIPT_RAW_URL="https://raw.githubusercontent.com/cloudxabide/ExMachina/main/bin/ollamactl"
SCRIPT_SHA256_URL="https://raw.githubusercontent.com/cloudxabide/ExMachina/main/bin/ollamactl.sha256"

NAME="open-webui"
IMAGE="ghcr.io/open-webui/open-webui:ollama"

usage() {
  cat <<EOF
Usage: $(basename "$0") <command>

Commands:
  start        Start Ollama + OpenWebUI (create container if needed)
  stop         Stop the container
  status       Show running state of the container
  list         List available Ollama models
  update       Pull the latest image and restart the container
  self-update  Pull the latest version of this script from git
EOF
  exit 1
}

require_docker() {
  if ! docker info >/dev/null 2>&1; then
    echo "Error: Docker daemon not reachable." >&2
    exit 1
  fi
}

do_start() {
  if [ -n "$(docker ps -q --filter "name=^${NAME}$" --filter "status=running")" ]; then
    echo "Container ${NAME} is already running."
  elif [ -n "$(docker ps -aq --filter "name=^${NAME}$")" ]; then
    echo "Starting existing container ${NAME}..."
    docker start "${NAME}" >/dev/null
    echo "Started."
  else
    echo "Creating and starting ${NAME}..."
    docker run -d \
      -p 12000:8080 \
      -p 11434:11434 \
      --gpus=all \
      -v open-webui:/app/backend/data \
      -v open-webui-ollama:/root/.ollama \
      -e OLLAMA_HOST=0.0.0.0:11434 \
      --name "${NAME}" \
      "${IMAGE}" >/dev/null
    echo "Started."
  fi
}

do_stop() {
  if [ -n "$(docker ps -q --filter "name=^${NAME}$" --filter "status=running")" ]; then
    echo "Stopping ${NAME}..."
    docker stop "${NAME}" >/dev/null
    echo "Stopped."
  else
    echo "Container ${NAME} is not running."
  fi
}

do_status() {
  running="$(docker ps -q --filter "name=^${NAME}$" --filter "status=running")"
  if [ -n "$running" ]; then
    echo "  ollama    : running  (port 11434)"
    echo "  open-webui: running  (port 12000)"
  else
    stopped="$(docker ps -aq --filter "name=^${NAME}$")"
    if [ -n "$stopped" ]; then
      echo "  ${NAME}: stopped"
    else
      echo "  ${NAME}: not found"
    fi
  fi
}

do_list() {
  if [ -z "$(docker ps -q --filter "name=^${NAME}$" --filter "status=running")" ]; then
    echo "Error: Container ${NAME} is not running." >&2
    exit 1
  fi
  docker exec "${NAME}" ollama list
}

do_update() {
  echo "Pulling latest image: ${IMAGE}..."
  docker pull "${IMAGE}"
  if [ -n "$(docker ps -q --filter "name=^${NAME}$" --filter "status=running")" ]; then
    echo "Stopping ${NAME}..."
    docker stop "${NAME}" >/dev/null
  fi
  if [ -n "$(docker ps -aq --filter "name=^${NAME}$")" ]; then
    echo "Removing old container..."
    docker rm "${NAME}" >/dev/null
  fi
  echo "Starting updated container..."
  docker run -d \
    -p 12000:8080 \
    -p 11434:11434 \
    --gpus=all \
    -v open-webui:/app/backend/data \
    -v open-webui-ollama:/root/.ollama \
    -e OLLAMA_HOST=0.0.0.0:11434 \
    --name "${NAME}" \
    "${IMAGE}" >/dev/null
  echo "Update complete."
}

do_self_update() {
  local script_path
  script_path=$(readlink -f "$0")
  local repo_root
  repo_root=$(git -C "$(dirname "$script_path")" rev-parse --show-toplevel 2>/dev/null || true)

  if [[ -n "$repo_root" ]]; then
    # Inside a clone — pull the repo
    echo "Repo: $repo_root"
    local before after
    before=$(git -C "$repo_root" rev-parse HEAD)
    git -C "$repo_root" pull --ff-only
    after=$(git -C "$repo_root" rev-parse HEAD)
    if [[ "$before" == "$after" ]]; then
      echo "Already up to date."
      return
    fi
    echo ""
    echo "Updated ${before:0:7}..${after:0:7}"
    git -C "$repo_root" log --oneline "${before}..${after}"
    if git -C "$repo_root" diff --name-only "${before}..${after}" | grep -q "$(basename "$script_path")"; then
      echo ""
      echo "$(basename "$0") was updated — changes are live."
    fi
  else
    # Standalone deployment — fetch directly from GitHub
    echo "Fetching latest $(basename "$0") from GitHub..."
    local tmp tmp_sum
    tmp=$(mktemp)
    tmp_sum=$(mktemp)
    if ! curl -fsSL "$SCRIPT_RAW_URL" -o "$tmp"; then
      echo "Error: download failed from $SCRIPT_RAW_URL" >&2
      rm -f "$tmp" "$tmp_sum"; exit 1
    fi
    if ! curl -fsSL "$SCRIPT_SHA256_URL" -o "$tmp_sum"; then
      echo "Error: checksum download failed from $SCRIPT_SHA256_URL" >&2
      rm -f "$tmp" "$tmp_sum"; exit 1
    fi
    local expected actual
    expected=$(tr -d '[:space:]' < "$tmp_sum")
    actual=$(sha256sum "$tmp" | awk '{print $1}')
    if [[ "$expected" != "$actual" ]]; then
      echo "Error: checksum mismatch (expected $expected, got $actual)" >&2
      rm -f "$tmp" "$tmp_sum"; exit 1
    fi
    chmod +x "$tmp"
    cp "$tmp" "$script_path"
    rm -f "$tmp" "$tmp_sum"
    echo "$(basename "$0") updated (checksum verified)."
  fi
}

# ── main ─────────────────────────────────────────────────────────────────────

cmd="${1:-}"
[[ -z "$cmd" ]] && usage

case "$cmd" in
  start)        require_docker; do_start ;;
  stop)         require_docker; do_stop ;;
  status)       require_docker; do_status ;;
  list)         require_docker; do_list ;;
  update)       require_docker; do_update ;;
  self-update)  do_self_update ;;
  *)
    echo "Error: Unknown command '${cmd}'" >&2
    usage
    ;;
esac
